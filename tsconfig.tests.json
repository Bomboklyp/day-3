{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": { "~/*": ["app/*"], "#shared/*": ["shared/*"] },
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "tests/**/*.ts",
    "app/types/**/*.ts",
    "app/data/**/*.ts",
    "app/utils/**/*.ts"
  ]
}
